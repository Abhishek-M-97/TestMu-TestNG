<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TestNG Assignment" parallel="classes" thread-count="3">
    <test name="Chrome on Windows 10">
        <parameter name="browserName" value="chrome"/>
        <parameter name="browserVersion" value="128.0"/>
        <parameter name="platformName" value="Windows 10"/>
        <parameter name="baseUrl" value="https://www.testmuai.com/selenium-playground/"/>
        <classes>
            <class name="com.lambdatest.TestNG_Scenarios"/>
        </classes>
    </test>
    <test name="Edge on macOS Ventura">
        <parameter name="browserName" value="MicrosoftEdge"/>
        <parameter name="browserVersion" value="127.0"/>
        <parameter name="platformName" value="macOS Ventura"/>
        <parameter name="baseUrl" value="https://www.testmuai.com/selenium-playground/"/>
        <classes>
            <class name="com.lambdatest.TestNG_Scenarios"/>
        </classes>
    </test>
    <test name="Firefox on Windows 11">
        <parameter name="browserName" value="firefox"/>
        <parameter name="browserVersion" value="130.0"/>
        <parameter name="platformName" value="Windows 11"/>
        <parameter name="baseUrl" value="https://www.testmuai.com/selenium-playground/"/>
        <classes>
            <class name="com.lambdatest.TestNG_Scenarios"/>
        </classes>
    </test>
</suite>
